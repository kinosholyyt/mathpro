rules_version = '2';

// MathPro дерекқорының ережелері.
// Firebase консолі → Firestore Database → Rules бөліміне осыны қойып, Publish бас.
service cloud.firestore {
  match /databases/{database}/documents {

    // Әкімші — тек admin@mathpro.app аккаунты
    function akimshiMa() {
      return request.auth != null && request.auth.token.email == "admin@mathpro.app";
    }

    // Оқушының деректері: әр оқушы тек өзінікін оқиды және өзгертеді.
    // Әкімші барлығын оқи алады және өшіре алады.
    match /oqushylar/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, delete: if akimshiMa();
    }

    // Сабақтар мен есептер: бәрі оқиды, тек әкімші өзгертеді.
    match /mazmun/{qujat} {
      allow read: if true;
      allow write: if akimshiMa();
    }
  }
}
